# Supabase Auth
# Get these from Supabase Plotted Development: Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Anon/public key (safe for frontend) — use as Client key for login
SUPABASE_ANON_KEY=your_anon_key_here
# Service role key (secret; for "Add User" and DB access)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT secret (Project Settings → API → JWT Secret) — required to verify user tokens
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Optional: set to false to disable SSL verification for Supabase HTTP and S3 storage (boto3) — dev only;
# fixes CERTIFICATE_VERIFY_FAILED / self-signed certificate when behind a corporate proxy or misconfigured CA.
# SUPABASE_SSL_VERIFY=false
# Optional: PEM bundle path for S3 uploads only when verify stays enabled (preferred over disabling verify).
# SUPABASE_S3_CA_BUNDLE=/path/to/corporate-root.pem

# Optional: for secure session signing
FLASK_SECRET_KEY=your_random_secret_here

# Optional: keep request-body limits aligned with large day/night video uploads.
# Defaults in code already allow day/night videos up to 200MB plus multipart overhead,
# but setting these explicitly makes deployment intent clearer.
# MAX_DAYNIGHT_VIDEO_BYTES=209715200
# MAX_UPLOAD_BYTES=214958080

# Optional: allow slower production uploads more time before the app worker times out.
# GUNICORN_TIMEOUT=300
