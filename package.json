{
  "name": "marketostate-portal",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/portal.css -o ./static/css/portal.bundle.css --minify",
    "copy:preline": "node scripts/copy-preline.js",
    "build": "npm run build:css && npm run copy:preline",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "preline": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^4.1.11"
  }
}